rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint: CampaignSave
    function isValidCampaignSave(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'characterName',
        'characterGrade',
        'arc',
        'location',
        'turnCount',
        'campaignPayload',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'characterName',
        'characterGrade',
        'arc',
        'location',
        'turnCount',
        'campaignPayload',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 160 &&
      data.characterName is string &&
      data.characterName.size() >= 1 &&
      data.characterName.size() <= 100 &&
      data.characterGrade is string &&
      data.characterGrade.size() >= 1 &&
      data.characterGrade.size() <= 60 &&
      data.arc is string &&
      data.arc.size() >= 1 &&
      data.arc.size() <= 160 &&
      data.location is string &&
      data.location.size() >= 1 &&
      data.location.size() <= 160 &&
      data.turnCount is number &&
      data.turnCount >= 0 &&
      data.turnCount <= 100000 &&
      data.campaignPayload is string &&
      data.campaignPayload.size() >= 2 &&
      data.campaignPayload.size() <= 900000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /campaigns/{campaignId} {
      allow get: if isVerifiedUser() && isValidId(campaignId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(campaignId) &&
        isValidCampaignSave(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(campaignId) &&
        isValidCampaignSave(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'characterName',
          'characterGrade',
          'arc',
          'location',
          'turnCount',
          'campaignPayload',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() && isValidId(campaignId) && existing().ownerId == request.auth.uid;
    }
  }
}
